# =====================================================================
# CRM 生产环境变量模板：复制为 .env 并替换为强随机值（.env 已被 .gitignore 排除）
# 密钥生成建议：openssl rand -base64 32（PG/Redis/MinIO 密码）；openssl rand -base64 48（JWT 密钥）
# =====================================================================

# PostgreSQL（compose 初始化与后端数据源共用）
CRM_PG_PASSWORD=change-me-strong-password

# Redis（requirepass 与后端 spring.data.redis.password 共用）
CRM_REDIS_PASSWORD=change-me-strong-password

# MinIO（root 用户 crm_minio 的密码，>=8 字符）
CRM_MINIO_PASSWORD=change-me-strong-password

# JWT 签名密钥：>=32 字节强随机串，缺失则后端启动失败（application-prod.yml 无默认值）
CRM_JWT_SECRET=change-me-at-least-32-bytes-random-secret

# 允许跨域的前端域名（逗号分隔，如 https://crm.example.com）；同源网关部署留空
CRM_CORS_ALLOWED_ORIGINS=
